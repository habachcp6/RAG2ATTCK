{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "config_name": "RAG2ATTCK Canonical Model Configuration",
  "config_version": "1.1.0",
  "provider": "openai",
  "model": "gpt-5.6-luna",
  "reasoning_effort": "xhigh",
  "api_interface": "responses",
  "max_output_tokens": 8192,
  "timeout_seconds": 120,
  "retry_policy": "exponential_backoff",
  "max_retries": 3,
  "retry_initial_delay_seconds": 1.0,
  "retry_backoff_factor": 2.0,
  "retry_max_delay_seconds": 30.0,
  "structured_output": {
    "format": "json_schema",
    "schema_name": "attack_technique_prediction",
    "strict": true,
    "target_field": "technique_id"
  },
  "logging_policy": {
    "log_token_usage": true,
    "log_latency": true,
    "log_prompt_version": true,
    "log_condition": true,
    "log_raw_response": false
  },
  "secret_policy": {
    "api_key_source": "environment_variable",
    "env_var_name": "OPENAI_API_KEY",
    "allow_hardcoded_keys": false
  }
}
